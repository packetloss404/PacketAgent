# Copy this file to `.env` and fill in at least ONE provider.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# OPENROUTER_API_KEY=sk-or-v1-...
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Everything below is optional. Defaults are fine for local development.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8484

# Required when NODE_ENV=production. Use a long random passphrase.
MASTER_KEY=

# Persistence: json, sqlite, or postgres.
PACKETAGENT_STORE=sqlite
PACKETAGENT_DB_PATH=data/packetagent.sqlite
# PACKETAGENT_DATABASE_URL=postgres://packetagent:change-me@postgres:5432/packetagent
# PACKETAGENT_MANAGED_DATABASE_ADAPTER=postgres

# Public-surface hardening.
PACKETAGENT_TRUST_PROXY=false
PACKETAGENT_RATE_LIMIT_KEY_SALT=
PACKETAGENT_AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
PACKETAGENT_AUTH_RATE_LIMIT_WINDOW_MS=60000
PACKETAGENT_INVITATION_RATE_LIMIT_MAX_ATTEMPTS=20
PACKETAGENT_INVITATION_RATE_LIMIT_WINDOW_MS=60000

# Sandbox execution. Production must use docker unless explicitly overriding
# the native host-shell guard for a trusted development environment.
PACKETAGENT_SANDBOX_DRIVER=docker
PACKETAGENT_SANDBOX_DEFAULT_RUNTIME=node-20
PACKETAGENT_SANDBOX_DEFAULT_TIMEOUT_MS=120000
PACKETAGENT_SANDBOX_MEMORY_MB=512
PACKETAGENT_SANDBOX_CPUS=1
# PACKETAGENT_ALLOW_INSECURE_NATIVE_SANDBOX=true

# Browser/sandbox artifacts require an authenticated viewer in the owning
# workspace when served. Serving is disabled unless explicitly enabled.
PACKETAGENT_ARTIFACT_SERVING_ENABLED=false

# Optional per-workspace Worker retention jobs. Unset cron means no automatic
# cleanup; jobs can still be enqueued explicitly with a workspace-bound policy.
# PACKETAGENT_WORKER_RETENTION_CRON=0 3 * * *
PACKETAGENT_WORKER_RETENTION_METADATA_DAYS=365
PACKETAGENT_WORKER_RETENTION_SUMMARY_DAYS=90
PACKETAGENT_WORKER_RETENTION_PROMPT_DAYS=30
PACKETAGENT_WORKER_RETENTION_TOOL_PAYLOAD_DAYS=30
PACKETAGENT_WORKER_RETENTION_ARTIFACT_DAYS=90
PACKETAGENT_WORKER_RETENTION_MAX_ITEMS=100
PACKETAGENT_WORKER_RETENTION_MAX_DURATION_MS=5000
PACKETAGENT_WORKER_RETENTION_DRY_RUN=false

# Optional distributed rate limiter.
# PACKETAGENT_DISTRIBUTED_RATE_LIMIT_URL=
# PACKETAGENT_DISTRIBUTED_RATE_LIMIT_SECRET=
# PACKETAGENT_DISTRIBUTED_RATE_LIMIT_TIMEOUT_MS=750
# PACKETAGENT_DISTRIBUTED_RATE_LIMIT_FAIL_OPEN=false
