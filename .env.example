# Copy this file to `.env` and fill in at least ONE provider.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# OPENROUTER_API_KEY=sk-or-v1-...
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Everything below is optional. Defaults are fine for local development.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8484

# Required when NODE_ENV=production. Use a long random passphrase.
MASTER_KEY=

# Persistence: json, sqlite, or postgres.
PACKETAGENT_STORE=sqlite
PACKETAGENT_DB_PATH=data/packetagent.sqlite
# PACKETAGENT_DATABASE_URL=postgres://packetagent:change-me@postgres:5432/packetagent
# PACKETAGENT_MANAGED_DATABASE_ADAPTER=postgres

# Optional legacy Agent email delivery. Autonomous Workers do not read these
# values; store strict SMTP JSON as an encrypted smtp_config Worker credential
# and pass only its declared vault: reference. Cleartext fallback is refused.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=PacketAgent <noreply@example.com>
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true

# Public-surface hardening.
PACKETAGENT_TRUST_PROXY=false
PACKETAGENT_RATE_LIMIT_KEY_SALT=
PACKETAGENT_AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
PACKETAGENT_AUTH_RATE_LIMIT_WINDOW_MS=60000
PACKETAGENT_INVITATION_RATE_LIMIT_MAX_ATTEMPTS=20
PACKETAGENT_INVITATION_RATE_LIMIT_WINDOW_MS=60000

# Generated previews must use a browser origin separate from the workbench.
# Development defaults to http://127.0.0.2:8484 for the preview origin.
# Production requires two different HTTPS hostnames, normally sibling hosts.
# PACKETAGENT_APP_ORIGIN=https://packetagent.example.com
# PACKETAGENT_PREVIEW_ORIGIN=https://preview.packetagent.example.com
# Optional dedicated signing key; PACKETAGENT_MASTER_KEY or MASTER_KEY is used
# when this is unset. Production refuses the baked-in development fallback.
# PACKETAGENT_PREVIEW_TOKEN_SECRET=

# Sandbox execution. Production must use docker unless explicitly overriding
# the native host-shell guard for a trusted development environment.
PACKETAGENT_SANDBOX_DRIVER=docker
PACKETAGENT_SANDBOX_DEFAULT_RUNTIME=node-20
PACKETAGENT_SANDBOX_DEFAULT_TIMEOUT_MS=120000
PACKETAGENT_SANDBOX_MAX_TIMEOUT_MS=120000
PACKETAGENT_SANDBOX_MEMORY_MB=512
PACKETAGENT_SANDBOX_CPUS=1
PACKETAGENT_SANDBOX_PIDS_LIMIT=64
PACKETAGENT_SANDBOX_TMPFS_MB=256
# Optional comma-separated exact http(s) origins for GET-only, host-brokered
# read-only inputs. Containers remain --network=none. Empty means deny-all.
# PACKETAGENT_SANDBOX_EGRESS_ALLOWLIST=https://example.com,https://api.example.com:8443
PACKETAGENT_SANDBOX_EGRESS_TIMEOUT_MS=15000
PACKETAGENT_SANDBOX_EGRESS_MAX_RESPONSE_BYTES=65536
# PACKETAGENT_ALLOW_INSECURE_NATIVE_SANDBOX=true

# Generated apps use one supervised Node child process per active app.
# The warm pool evicts the least recently used idle process when this limit is
# reached. Values are clamped to 1-64; the default is 4.
PACKETAGENT_GENERATED_APP_RUNTIME_MAX_PROCESSES=4

# Optional authenticity layer for generated-app publish manifests. Checksums
# are always present. If set, the signing key must contain at least 32 bytes;
# only the non-secret key ID and HMAC are written to the manifest.
# PACKETAGENT_PUBLISH_MANIFEST_SIGNING_KEY=
# PACKETAGENT_PUBLISH_MANIFEST_SIGNING_KEY_ID=packetagent-local

# Comma-separated SHA-256 SPKI fingerprints trusted for signed Agent–Worker
# bundle imports. Local production exports use an Ed25519 identity derived from
# MASTER_KEY; an unlisted remote fingerprint requires explicit admin
# acknowledgement during import.
# PACKETAGENT_AGENT_BUNDLE_TRUSTED_KEY_IDS=sha256:...

# Browser/sandbox artifacts require an authenticated viewer in the owning
# workspace when served. Serving is disabled unless explicitly enabled.
PACKETAGENT_ARTIFACT_SERVING_ENABLED=false

# Optional per-workspace Worker retention jobs. Unset cron means no automatic
# cleanup; jobs can still be enqueued explicitly with a workspace-bound policy.
# PACKETAGENT_WORKER_RETENTION_CRON=0 3 * * *
PACKETAGENT_WORKER_RETENTION_METADATA_DAYS=365
PACKETAGENT_WORKER_RETENTION_SUMMARY_DAYS=90
PACKETAGENT_WORKER_RETENTION_PROMPT_DAYS=30
PACKETAGENT_WORKER_RETENTION_TOOL_PAYLOAD_DAYS=30
PACKETAGENT_WORKER_RETENTION_ARTIFACT_DAYS=90
PACKETAGENT_WORKER_RETENTION_MAX_ITEMS=100
PACKETAGENT_WORKER_RETENTION_MAX_DURATION_MS=5000
PACKETAGENT_WORKER_RETENTION_DRY_RUN=false

# Optional distributed rate limiter.
# PACKETAGENT_DISTRIBUTED_RATE_LIMIT_URL=
# PACKETAGENT_DISTRIBUTED_RATE_LIMIT_SECRET=
# PACKETAGENT_DISTRIBUTED_RATE_LIMIT_TIMEOUT_MS=750
# PACKETAGENT_DISTRIBUTED_RATE_LIMIT_FAIL_OPEN=false
