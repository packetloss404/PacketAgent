{
  "name": "packetagent",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "homepage": "https://packetloss404.github.io/packetagent/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/packetloss404/packetagent.git"
  },
  "bugs": {
    "url": "https://github.com/packetloss404/packetagent/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta -k --raw \"node --import tsx --watch src/server.ts\" \"vite --config web/vite.config.ts\"",
    "dev:api": "node --import tsx --watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run typecheck && npm test",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "npm run start:server",
    "start:server": "node --import tsx src/server.ts",
    "db:migrate": "node --import tsx src/db/cli.ts migrate",
    "db:status": "node --import tsx src/db/cli.ts status",
    "db:backup": "node --import tsx src/db/cli.ts backup",
    "db:restore": "node --import tsx src/db/cli.ts restore",
    "db:seed": "node --import tsx src/db/cli.ts seed-db",
    "db:seed-app": "node --import tsx src/db/cli.ts seed-app",
    "db:backfill": "node --import tsx src/db/cli.ts backfill",
    "db:backfill-managed-postgres": "node --import tsx src/db/cli.ts backfill-managed-postgres",
    "db:verify-managed-postgres": "node --import tsx src/db/cli.ts verify-managed-postgres",
    "db:reset": "node --import tsx src/db/cli.ts reset-db",
    "db:reset-app": "node --import tsx src/db/cli.ts reset-app",
    "db:backfill-job-metric-snapshots": "node --import tsx src/db/cli.ts backfill-job-metric-snapshots",
    "db:verify-job-metric-snapshots": "node --import tsx src/db/cli.ts verify-job-metric-snapshots",
    "db:backfill-alert-events": "node --import tsx src/db/cli.ts backfill-alert-events",
    "db:verify-alert-events": "node --import tsx src/db/cli.ts verify-alert-events",
    "db:backfill-agent-runs": "node --import tsx src/db/cli.ts backfill-agent-runs",
    "db:verify-agent-runs": "node --import tsx src/db/cli.ts verify-agent-runs",
    "db:backfill-jobs": "node --import tsx src/db/cli.ts backfill-jobs",
    "db:verify-jobs": "node --import tsx src/db/cli.ts verify-jobs",
    "db:backfill-invitation-email-deliveries": "node --import tsx src/db/cli.ts backfill-invitation-email-deliveries",
    "db:verify-invitation-email-deliveries": "node --import tsx src/db/cli.ts verify-invitation-email-deliveries",
    "db:backfill-activities": "node --import tsx src/db/cli.ts backfill-activities",
    "db:verify-activities": "node --import tsx src/db/cli.ts verify-activities",
    "db:backfill-provider-calls": "node --import tsx src/db/cli.ts backfill-provider-calls",
    "db:verify-provider-calls": "node --import tsx src/db/cli.ts verify-provider-calls",
    "db:backfill-activation-signals": "node --import tsx src/db/cli.ts backfill-activation-signals",
    "db:verify-activation-signals": "node --import tsx src/db/cli.ts verify-activation-signals",
    "store:seed": "node --import tsx src/db/cli.ts seed-store",
    "store:reset": "node --import tsx src/db/cli.ts reset-store",
    "jobs:recompute-activation": "node --import tsx src/jobs.ts recompute-activation",
    "jobs:repair-activation": "node --import tsx src/jobs.ts repair-activation-read-models",
    "jobs:cleanup-sessions": "node --import tsx src/jobs.ts cleanup-sessions",
    "jobs:export-workspace": "node --import tsx src/jobs.ts export-workspace",
    "jobs:reconcile-invitation-emails": "node --import tsx src/jobs.ts reconcile-invitation-emails",
    "jobs:snapshot-metrics": "node --import tsx src/jobs.ts snapshot-job-metrics",
    "access-log:rotate": "node --import tsx src/security/access-log-rotate-cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node --import tsx --test-concurrency=1 --test \"src/**/*.test.ts\"",
    "test:web": "tsx --tsconfig web/tsconfig.json --test \"web/src/**/*.test.ts\" \"web/src/**/*.test.tsx\"",
    "verify:generated-app-publish": "node --import tsx src/generated-app-publish-verify-cli.ts",
    "verify:generated-app-reachability": "node --import tsx src/generated-app-publish-reachability-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@hono/node-server": "^2.0.12",
    "clsx": "^2.1.1",
    "esbuild": "0.27.2",
    "fflate": "^0.8.3",
    "hono": "^4.12.32",
    "lucide-react": "^0.542.0",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.4",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "postcss": "^8.5.25",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.3.6"
  },
  "optionalDependencies": {
    "playwright": "^1.59.1"
  },
  "overrides": {
    "esbuild": "0.27.2"
  }
}
