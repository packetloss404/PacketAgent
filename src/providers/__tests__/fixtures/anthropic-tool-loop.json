{
  "$comment": "Recorded Messages API transcripts in the shapes the @anthropic-ai/sdk returns them, replayed by strict-anthropic-server.ts. A tool_use.input given as a string stands in for a garbled/truncated tool input so the provider's malformed-input path is exercised. `events` turns are raw stream events and are only served through messages.stream().",
  "model": "claude-opus-4-7",
  "scenarios": {
    "text_only": {
      "description": "Plain answer, no tools used.",
      "turns": [
        {
          "message": {
            "id": "msg_text_only_1",
            "content": [{ "type": "text", "text": "Lisbon is the capital of Portugal." }],
            "stop_reason": "end_turn",
            "usage": { "input_tokens": 142, "output_tokens": 11 }
          }
        }
      ]
    },
    "single_tool_call": {
      "description": "One tool call, then a final answer that uses the result.",
      "turns": [
        {
          "message": {
            "id": "msg_single_1",
            "content": [
              { "type": "text", "text": "Let me check the weather." },
              {
                "type": "tool_use",
                "id": "toolu_01A1",
                "name": "get_weather",
                "input": { "city": "Lisbon" }
              }
            ],
            "stop_reason": "tool_use",
            "usage": { "input_tokens": 210, "output_tokens": 54, "cache_read_input_tokens": 0 }
          }
        },
        {
          "message": {
            "id": "msg_single_2",
            "content": [{ "type": "text", "text": "It is 24C and sunny in Lisbon." }],
            "stop_reason": "end_turn",
            "usage": { "input_tokens": 290, "output_tokens": 14 }
          }
        }
      ]
    },
