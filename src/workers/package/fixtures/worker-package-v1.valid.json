  "schemaVersion": "packetagent.worker-package/v1",
  "packageId": "packetade:flight-42:release-watcher",
  "packageVersion": 1,
  "idempotencyKey": "packetade:flight-42:release-watcher:v1",
  "createdAt": "2026-07-28T15:00:00.000Z",
  "createdBy": {
    "type": "packet_product",
    "id": "packetade:flight-42",
